{
  "name": "a-pulso-cofrade-windows",
  "version": "3.1.1",
  "productName": "A Pulso Cofrade - Editor de Mapas",
  "description": "Taller de mapas A Pulso Cofrade para Windows, con fotografías, guardados persistentes y copias de seguridad independientes del navegador",
  "author": "A Pulso Cofrade",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node prepare-assets.cjs",
    "dist:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "es.realidad90fc.apulso.editor",
    "productName": "A Pulso Cofrade - Editor de Mapas",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "A-Pulso-Editor-de-Mapas-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "A Pulso Cofrade - Editor de Mapas",
      "deleteAppDataOnUninstall": false
    }
  }
}
